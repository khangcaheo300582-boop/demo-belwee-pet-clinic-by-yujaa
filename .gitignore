# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template is safe to commit and must ship so others can copy it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data (bookings persistence)
/data/

# debug / scratch / backup artifacts
*.log
devlog.txt
.tmp*
tmp-*
home.png
backup_*.tar.gz
.aider.*
.claude/
.zcode/

# original (uncompressed) media backups
/media-backup/
.libs/
.libs/*
.libs/**

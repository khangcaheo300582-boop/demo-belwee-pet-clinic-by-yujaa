# Chặn npm từ chối cài đặt vì xung đột peer dependency "optional".
#
# Nguyên nhân gốc:
#   next-auth@4.24.15 khai báo peerDependencies: { nodemailer: "^7.0.7" }
#   với peerDependenciesMeta: { nodemailer: { optional: true } }.
#   Peer này CHỈ dùng cho EmailProvider của next-auth — dự án này không dùng
#   EmailProvider, mà tự gửi mail qua lib/mailer.ts.
#
# Vì sao KHÔNG hạ nodemailer xuống v7 để "chiều" peer:
#   nodemailer 7.x dính NHIỀU advisory hơn 9.x/10.x, gồm cả DoS mức high
#   (GHSA-rcmh-qjqh-p98v, addressparser đệ quy, phạm vi <=7.0.10).
#   Hạ phiên bản để làm hài lòng một peer optional không dùng là tạo rủi ro
#   bảo mật thực sự. Hướng sửa đúng là nâng nodemailer lên >=9.1.1.
#
# Vì sao dùng legacy-peer-deps:
#   Đây là cơ chế được npm chuẩn bị cho đúng trường hợp "peer optional không
#   dùng nhưng phiên bản đã cài không khớp". Nó KHÔNG hạ phiên bản bất kỳ package
#   nào và không ảnh hưởng dependency thực sự của dự án.
#   Nếu sau này gặp xung đột peer KHÔNG optional, hãy sửa đúng version thay vì
#   dựa vào cờ này.
legacy-peer-deps=true

# Không phát sinh file lock khi chạy cài đặt trong môi trường CI (không cần commit)
package-lock=true
audit=true
fund=false

{
  "name": "belwee-pet-clinic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-run.js dev",
    "dev:lan": "node scripts/next-run.js dev -H 0.0.0.0",
    "clean": "node scripts/clean.js",
    "build": "next build",
    "build:clean": "node scripts/clean.js && next build",
    "start": "next build && node scripts/next-run.js start",
    "start:lan": "next build && node scripts/next-run.js start -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx scripts/verify-json-store.ts",
    "env:check": "tsx scripts/env-health.ts",
    "test:staff": "tsx scripts/verify-staff-auth.ts",
    "test:staff-surface": "tsx scripts/verify-staff-auth-surface.ts",
    "migrate:admin": "tsx scripts/migrate-admin.ts",
    "test:smoke": "tsx scripts/verify-site-smoke.ts",
    "test:map": "tsx scripts/verify-clinic-map.ts",
    "audit:staff": "tsx scripts/audit-staff-records.ts",
    "clean:staff": "tsx scripts/staff-data-cleanup.ts",
    "test:otp": "tsx scripts/verify-otp.ts",
    "test:species": "tsx scripts/verify-pet-species.ts",
    "test:tools": "tsx scripts/verify-pet-care-tools.ts",
    "test:motion": "tsx scripts/verify-motion.ts",
    "test:timeline": "tsx scripts/verify-booking-timeline.ts",
    "test:rsc": "tsx scripts/verify-rsc-imports.ts",
    "test:intro": "tsx scripts/verify-intro-gate.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:unit && npm run test:staff && npm run test:otp && npm run test:species && npm run test:tools && npm run test:motion && npm run test:timeline && npm run test:rsc",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "analyze": "cross-env ANALYZE=true npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@sentry/nextjs": "^11.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.2.0",
    "gsap": "^3.15.0",
    "html2pdf.js": "^0.14.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.42.0",
    "next": "14.2.4",
    "next-auth": "^4.24.14",
    "nodemailer": "^9.1.1",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "happy-dom": "^21.0.3",
    "husky": "^9.1.7",
    "leaflet": "^1.9.4",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.6.0",
    "next-bundle-analyzer": "^0.6.8",
    "playwright-core": "^1.62.1",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}

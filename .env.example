# =========================================================================
# BELWEE PET CLINIC — MẪU BIẾN MÔI TRƯỜNG
# =========================================================================
# Cách dùng:
#   cp .env.example .env.local      (Windows: copy .env.example .env.local)
#   rồi điền các giá trị thật vào .env.local
#
# `.env.local` KHÔNG được commit. File mẫu này thì có.
# Next.js chỉ nạp biến môi trường khi khởi động → sửa xong phải restart dev server.
#
# Tạo secret ngẫu nhiên (>= 32 ký tự):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =========================================================================

# -------------------------------------------------------------------------
# 1. MÁY CHỦ
# -------------------------------------------------------------------------
# Cổng dev server mặc định.
PORT=3001
# URL công khai của ứng dụng (dùng cho callback OAuth, link trong email).
NEXTAUTH_URL=http://localhost:3001
NEXT_PUBLIC_BASE_URL=http://localhost:3001
# Để trống = gọi API cùng origin (khuyến nghị).
NEXT_PUBLIC_API_BASE_URL=

# -------------------------------------------------------------------------
# 2. SECRETS — BẮT BUỘC, MỖI BIẾN MỘT GIÁ TRỊ RIÊNG
# -------------------------------------------------------------------------
# Session cookie của NextAuth.
NEXTAUTH_SECRET=replace-with-32-plus-random-chars
# Cookie phiên đăng nhập nhân viên (PIN).
STAFF_SESSION_SECRET=replace-with-a-different-32-plus-random-value
# Hash mã OTP gửi qua email.
OTP_HASH_SECRET=replace-with-another-32-plus-random-value
# JWT cho auth module v1 (/api/v1/auth/*).
JWT_SECRET=replace-with-another-32-plus-random-value
# Hash token đặt lại mật khẩu (để trống = dùng NEXTAUTH_SECRET).
RESET_TOKEN_HASH_SECRET=
# Bảo vệ các endpoint cron nội bộ.
CRON_SECRET=replace-with-a-random-value

# -------------------------------------------------------------------------
# 3. EMAIL / OTP
# -------------------------------------------------------------------------
# BẮT BUỘC cho /api/auth/send-otp. Dùng Gmail App Password (16 ký tự),
# KHÔNG dùng mật khẩu đăng nhập Gmail.
EMAIL_USER=belweepetclinic@gmail.com
EMAIL_PASS=your-gmail-app-password
# Hộp thư nhận thông báo đặt lịch (để trống = EMAIL_USER).
EMAIL_RECEIVER=

# -------------------------------------------------------------------------
# 4. GOOGLE OAUTH
# -------------------------------------------------------------------------
# Tạo tại https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------------------------------------------------
# 5. TÀI KHOẢN NHÂN VIÊN
# -------------------------------------------------------------------------
# BẮT BUỘC cho /api/staff/reset-pin (thiếu → 503).
STAFF_RECOVERY_CODE=replace-with-a-6-digit-code

# Seed admin đầu tiên: chỉ bật true một lần trên máy mới.
# Khi ALLOW_STAFF_SEED=true, PIN được sinh ngẫu nhiên và in ra console.
# KHÔNG đặt STAFF_INIT_PIN cùng lúc với seed (tránh PIN cố định trong file).
ALLOW_STAFF_SEED=false
STAFF_INIT_PIN=
# Chỉ dùng cho `npm run migrate:admin` (>= 10 ký tự).
SEED_ADMIN_PASSWORD=

# -------------------------------------------------------------------------
# 6. BẢO MẬT
# -------------------------------------------------------------------------
# Origin bổ sung được phép gọi API, cách nhau bởi dấu phẩy.
# NEXTAUTH_URL và NEXT_PUBLIC_BASE_URL luôn được tự động chấp nhận.
SECURITY_TRUSTED_ORIGINS=
# true = bắt buộc cookie Secure. Để trống = tự theo giao thức.
STAFF_COOKIE_SECURE=
# Ghi audit log vào data/logs/ (bật ở production).
SECURITY_AUDIT=false
SECURITY_AUDIT_COLOR=1
SECURITY_AUDIT_FORMAT=human

# -------------------------------------------------------------------------
# 7. SENTRY (tùy chọn)
# -------------------------------------------------------------------------
# Để trống nếu không dùng. Không đặt DSN giả.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_ENABLED=false
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# -------------------------------------------------------------------------
# 8. DỮ LIỆU DEMO
# -------------------------------------------------------------------------
# 'false' = không tự tạo hồ sơ bệnh án demo cho cổng khách hàng.
ALLOW_SEED=false
